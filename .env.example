# Docker Compose interpolation variables (project root).
# Copy to `.env` to pin values; compose reads THIS location for ${VAR} substitution
# in docker-compose*.yml (a per-service services/*/.env is loaded INTO a container, not here).

# Which published image tag the PROD compose pulls from GHCR (ghcr.io/florian-barre/docforge-*).
# Defaults to `latest` when unset (the `:-latest` fallback in the compose files). Pin a release:
#   DOCFORGE_TAG=1.2.3
# worker/bge-server append `-cpu` (base) or `-gpu` (compose/overlays/gpu.yml) to this automatically.
DOCFORGE_TAG=latest

# ───── Optional TLS reverse proxy (compose/overlays/proxy.yml only) ─────
# Only needed if you layer compose/overlays/proxy.yml (Caddy, auto-HTTPS). Unused otherwise.
# See docs/PROD-HARDENING.md's "Optional TLS reverse proxy" section before enabling.
# The public DNS name Caddy requests a Let's Encrypt certificate for — must already have an
# A/AAAA record pointing at this host, with 80+443 reachable from the internet.
# DOCFORGE_DOMAIN=docforge.example.com
# Contact address Let's Encrypt uses for expiry/revocation notices — any address you monitor.
# DOCFORGE_ACME_EMAIL=ops@example.com

# ───── Optional telemetry overlay (compose/overlays/telemetry.yml only) ─────
# Only needed if you layer compose/overlays/telemetry.yml (Prometheus/Loki/Promtail/Grafana).
# Grafana admin password (user: admin) — CHANGE before exposing Grafana beyond
# localhost/an operator VPN. See compose/README.md's "The telemetry stack" section.
# GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
