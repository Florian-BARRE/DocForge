# Docker Compose interpolation variables (project root).
# Copy to `.env` to pin values; compose reads THIS location for ${VAR} substitution
# in docker-compose*.yml (a per-service services/*/.env is loaded INTO a container, not here).

# Which published image tag the PROD compose pulls from GHCR (ghcr.io/florian-barre/docforge-*).
# Defaults to `latest` when unset (the `:-latest` fallback in the compose files). Pin a release:
#   DOCFORGE_TAG=1.2.3
# worker/bge-server append `-cpu` (base) or `-gpu` (compose/overlays/compose.gpu.yml) to this automatically.
DOCFORGE_TAG=latest

# ───── PostgreSQL DSN (the ONE place a real deployment sets DB credentials) ─────
# compose/compose.base.yml injects POSTGRES_DSN into app+worker with a ${POSTGRES_DSN:-...docforge:docforge...}
# fallback — that literal is the LOCAL-DEV default only. For any real deployment, set a strong password
# here AND mirror it in services/docforge/postgres.env's POSTGRES_PASSWORD (the DB is bootstrapped from
# that file on first start), so the three stay in sync. The compose `environment:` override always wins
# over a per-service env_file, so THIS is the value app+worker actually connect with.
#   POSTGRES_DSN=postgresql+asyncpg://docforge:CHANGE_ME_STRONG@docforge_postgres:5432/docforge

# ───── Optional TLS reverse proxy (compose/overlays/compose.proxy.yml only) ─────
# Only needed if you layer compose/overlays/compose.proxy.yml (Caddy, auto-HTTPS). Unused otherwise.
# See docs/PROD-HARDENING.md's "Optional TLS reverse proxy" section before enabling.
# The public DNS name Caddy requests a Let's Encrypt certificate for — must already have an
# A/AAAA record pointing at this host, with 80+443 reachable from the internet.
# DOCFORGE_DOMAIN=docforge.example.com
# Contact address Let's Encrypt uses for expiry/revocation notices — any address you monitor.
# DOCFORGE_ACME_EMAIL=ops@example.com

# ───── Optional telemetry overlay (compose/overlays/compose.telemetry.yml only) ─────
# Only needed if you layer compose/overlays/compose.telemetry.yml (Prometheus/Loki/Promtail/Grafana).
# Grafana admin credentials are NOT a project-root .env var — they live in
# services/telemetry/.env (GF_SECURITY_ADMIN_USER / GF_SECURITY_ADMIN_PASSWORD, Grafana's own
# env vars, injected via env_file), the same discoverable per-service config home as
# services/caddy and services/docforge. Copy services/telemetry/.env.example -> .env and change
# the password before exposing Grafana beyond localhost/an operator VPN. See compose/README.md's
# "The telemetry stack" section.
# TELEMETRY_BIND_ADDR (host bind address for grafana/prometheus/loki's published ports,
# default 127.0.0.1) IS a project-root .env var — see compose/overlays/compose.telemetry.yml's header.
# TELEMETRY_BIND_ADDR=127.0.0.1
