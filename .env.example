# Docker Compose interpolation variables (project root).
# Copy to `.env` to pin values; compose reads THIS location for ${VAR} substitution
# in docker-compose*.yml (a per-service services/*/.env is loaded INTO a container, not here).

# Which published image tag the PROD compose pulls from GHCR (ghcr.io/florian-barre/docforge-*).
# Defaults to `latest` when unset (the `:-latest` fallback in the compose files). Pin a release:
#   DOCFORGE_TAG=1.2.3
# worker/bge-server append `-cpu` (base) or `-gpu` (docker-compose.gpu.yml) to this automatically.
DOCFORGE_TAG=latest
