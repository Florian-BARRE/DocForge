      },
      {
        "block_label": "paragraph_title",
        "block_content": "6.3 English Constituency Parsing",
        "block_bbox": [
          211,
          1119,
          515,
          1143
        ],
        "block_id": 5,
        "block_order": 4,
        "group_id": 5,
