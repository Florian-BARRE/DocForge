      {
        "block_label": "text",
        "block_content": "development set, newstest2013. We used beam search as described in the previous section, but no checkpoint averaging. We present these results in Table 3.",
        "block_bbox": [
          210,
          826,
          1011,
          871
        ],
        "block_id": 2,
        "block_order": 1,
        "group_id": 2,
        "block_polygon_points": [
