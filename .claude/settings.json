{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "opusplan",
  "effortLevel": "high",

  "autocompactThreshold": 80,
  "enableAllProjectMcpServers": true,

  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Agent(*)"
    ],
    "ask": [
      "Bash(* rm -rf *)",
      "Bash(rm -rf *)",
      "Bash(* git push --force*)",
      "Bash(git push --force*)",
      "Bash(* git reset --hard*)",
      "Bash(git reset --hard*)",
      "Bash(* git clean -f*)",
      "Bash(git clean -f*)",
      "Bash(alembic downgrade*)",
      "Bash(podman system prune*)",
      "Bash(podman-compose down*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py PreToolUse",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py PostToolUse",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py PostToolUseFailure",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py Stop",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py SubagentStop",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ]
  },

  "plansDirectory": "docs/plans",

  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },

  "autoUpdatesChannel": "latest"
}
