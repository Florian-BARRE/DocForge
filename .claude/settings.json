{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",

  "autocompactThreshold": 80,
  "enableAllProjectMcpServers": true,

  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Agent(*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py PreToolUse",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py PostToolUse",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py PostToolUseFailure",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py Stop",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hooks.py SubagentStop",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ]
  },

  "plansDirectory": "docs/plans",

  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },

  "autoUpdatesChannel": "latest"
}
