{
  "title": "DocForge — API & HTTP",
  "uid": "docforge-api",
  "tags": [
    "docforge"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "docforge"
      ],
      "targetBlank": false,
      "title": "DocForge dashboards",
      "type": "dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "docforge-prometheus"
        },
        "query": "label_values(docforge_http_requests_total, path)",
        "regex": "/^\\/.+/",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "docforge-prometheus"
        },
        "query": "label_values(docforge_http_requests_total, method)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Golden signals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Total request rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(docforge_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "4xx ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8a8378",
                "value": null
              },
              {
                "color": "#f4a63b",
                "value": 0.1
              },
              {
                "color": "#c8402c",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(docforge_http_requests_total{status=~\"4..\"}[5m])) / sum(rate(docforge_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "#8a8378"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f7d4f",
                "value": null
              },
              {
                "color": "#f4a63b",
                "value": 0.01
              },
              {
                "color": "#c8402c",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(docforge_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(docforge_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(docforge_http_requests_in_progress)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request rate by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2f7d4f"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f4a63b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c8402c"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (label_replace(rate(docforge_http_requests_total[1m]), \"status_class\", \"${1}xx\", \"status\", \"(.)..\"))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error ratio over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(docforge_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(docforge_http_requests_total[5m]))",
          "legendFormat": "5xx ratio"
        },
        {
          "refId": "B",
          "expr": "sum(rate(docforge_http_requests_total{status=~\"4..\"}[5m])) / sum(rate(docforge_http_requests_total[5m]))",
          "legendFormat": "4xx ratio"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Latency percentiles (p50 / p90 / p95 / p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(docforge_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.90, sum by (le) (rate(docforge_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(docforge_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "D",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(docforge_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 11,
      "title": "Average latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(rate(docforge_http_request_duration_seconds_sum[5m])) / sum(rate(docforge_http_request_duration_seconds_count[5m]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 12,
      "title": "Latency heatmap (request duration buckets)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 128,
          "reverse": false
        },
        "cellGap": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(docforge_http_request_duration_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "By route ($route, $method)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "title": "Top routes by request rate",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (path) (rate(docforge_http_requests_total{path=~\"$route\", method=~\"$method\"}[5m])))",
          "legendFormat": "{{path}}",
          "instant": true
        }
      ]
    },
    {
      "id": 21,
      "title": "Top routes by p95 latency",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * topk(10, histogram_quantile(0.95, sum by (le, path) (rate(docforge_http_request_duration_seconds_bucket{path=~\"$route\", method=~\"$method\"}[5m]))))",
          "legendFormat": "{{path}}",
          "instant": true
        }
      ]
    },
    {
      "id": 22,
      "title": "p95 latency by route (over time)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, path) (rate(docforge_http_request_duration_seconds_bucket{path=~\"$route\", method=~\"$method\"}[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 23,
      "title": "Status-code breakdown (stacked)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(docforge_http_requests_total{path=~\"$route\", method=~\"$method\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 24,
      "title": "Request rate by method",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(docforge_http_requests_total{path=~\"$route\", method=~\"$method\"}[1m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Raw table",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "title": "Requests by method / path / status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "docforge-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, path, status) (docforge_http_requests_total{path=~\"$route\", method=~\"$method\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    }
  ]
}
