# ─── Telemetry stack (opt-in overlay: compose/overlays/compose.telemetry.yml) ───
# Grafana admin login — how you sign in at http://<host>:10050 (user below / password below).
# These are Grafana's NATIVE env vars, injected via `env_file`. CHANGE the password before
# exposing Grafana beyond localhost/VPN.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_admin
