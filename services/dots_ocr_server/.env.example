# ─── dots.ocr per-element layout VLM sidecar — environment template ──────────────────────────
# Copy to `services/dots_ocr_server/.env`.
# All vars have safe defaults — the service starts without any .env file at all.
#
# GPU-ONLY: dots.ocr is served by HuggingFace transformers (fp16 + SDPA) and REQUIRES CUDA. WHY
# transformers, not vLLM: the prod GPU is a Tesla V100 (sm_70) and vLLM >=0.11 dropped Volta support;
# transformers on torch cu126 still runs on sm_70. This sidecar is opt-in (compose profile `dots_ocr`,
# GPU image) and reports /health UNHEALTHY on a host with no CUDA GPU.
#
# ── Build variants (selected at IMAGE BUILD TIME, not via .env) ──────────────
# The Dockerfile ARG TORCH_VARIANT controls which torch wheel (and whether transformers) is installed:
#   gpu (CUDA 12.6, for the Tesla V100 sm_70 prod GPU): docker compose build --build-arg TORCH_VARIANT=gpu dots_ocr_server
#   cpu (wiring build-test ONLY — cannot actually parse, no transformers): docker compose build dots_ocr_server

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat
LOGGING_ENABLE_CONSOLE=true
LOGGING_ENABLE_FILE=false
LOGGING_FILE_LEVEL=DEBUG

# ───── Model cache ─────
# Directory transformers caches the downloaded dots.ocr weights under (HF_HOME). Mounted as a named
# volume in compose so weights persist across container recreations.
DOTS_OCR_MODEL_CACHE_HOME=/models
# HuggingFace model id (or a local path) transformers loads. NOTE: the task brief spelled the repo `dots.mocr`;
# the actual HuggingFace repo is `rednote-hilab/dots.ocr`. Override here if the brief was correct.
DOTS_OCR_MODEL_PATH=rednote-hilab/dots.ocr

# ───── Rendering ─────
# DPI each PDF page is rasterised to before it is sent to the VLM. Higher = sharper small text but
# larger images (slower, more VRAM). The rendered px width/height become the bbox normalization divisor.
DOTS_OCR_RENDER_DPI=200
# Hard ceiling on pages parsed from one PDF (0 = no cap). Pages beyond the cap are dropped (logged).
DOTS_OCR_MAX_PAGES=0
# Max new tokens the VLM may emit per page (the JSON layout list). Large enough for a dense page.
DOTS_OCR_MAX_TOKENS=16384

# ───── Smart-resize (Qwen2-VL) ─────
# dots.ocr is a Qwen2-VL-family VLM: its processor resizes each page to a multiple of IMAGE_FACTOR
# within [MIN_PIXELS, MAX_PIXELS] before the encoder and returns bboxes in THAT frame. The sidecar
# resizes to the same dims itself (the honest bbox divisor) and pins MIN/MAX on the transformers processor.
# Defaults follow the dots.ocr repo consts — verify against the model card on first GPU deploy.
DOTS_OCR_IMAGE_FACTOR=28
DOTS_OCR_MIN_PIXELS=3136
DOTS_OCR_MAX_PIXELS=11289600

# ───── GPU gate ─────
# When true (default), /health reports UNHEALTHY on a host with no visible CUDA GPU so the container
# never advertises a readiness it cannot honor. Set false only for a deliberate CPU wiring smoke-test.
DOTS_OCR_REQUIRE_GPU=true

# ───── Request limits ─────
# Hard ceiling (bytes) on a /parse request body the route will buffer (the body IS the PDF).
DOTS_OCR_MAX_BODY_BYTES=104857600

# ───── Concurrency ─────
# Max seconds a /parse request waits to acquire the shared predict lock before the router returns
# HTTP 503 (back-pressure — dots.ocr VLM inference is not concurrency-safe on one GPU).
DOTS_OCR_LOCK_WAIT_TIMEOUT_SECONDS=590
