# ─── BGE model-suite server — environment template ───────────────────────────
# Copy to `services/bge_server/.env`.
# All vars have safe defaults — the service starts without any .env file at all.
# Values here match the production docker compose setup.
#
# ── Build variants (selected at IMAGE BUILD TIME, not via .env) ──────────────
# The Dockerfile ARG TORCH_VARIANT controls which torch wheel is installed:
#   cpu (default, ~2 GB): docker compose build bge_server
#   gpu (~9.5 GB, CUDA 12.4): docker compose build --build-arg TORCH_VARIANT=gpu bge_server
# Set BGE_DEVICE=cuda below when using the gpu image.

# ───── Logging ─────
# Console log level: DEBUG | INFO | WARNING | ERROR
LOGGING_CONSOLE_LEVEL=INFO
# loggerplusplus format class: ShortFormat | DebugFormat
LOGGING_LPP_FORMAT=ShortFormat
# Set to false to disable console output (e.g. redirect to a log aggregator).
LOGGING_ENABLE_CONSOLE=true
# Set to true to enable rotating file logs under /app/bge_server/logs/.
LOGGING_ENABLE_FILE=false
LOGGING_FILE_LEVEL=DEBUG

# ───── BGE model identities ─────
# HuggingFace model ID for the dense + sparse embedding model (BGEM3FlagModel).
BGE_M3_MODEL=BAAI/bge-m3
# HuggingFace model ID for the cross-encoder reranker (FlagReranker).
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ───── BGE device policy ─────
# Controls which compute device the models are loaded on.
#   auto  -> prefer GPU (CUDA) if available, fall back to CPU silently (default, safe everywhere).
#   cuda  -> require GPU; fails loud at startup if no CUDA device is found (no silent fallback).
#   cpu   -> always use CPU regardless of GPU availability.
# GPU reservation in docker compose: see the commented `reservations:` block under bge_server deploy.
BGE_DEVICE=auto

# ───── BGE runtime knobs ─────
# Request fp16 precision. GATED: only applied when BGE_DEVICE resolves to "cuda".
# If BGE_FP16=true but the resolved device is "cpu" (e.g. BGE_DEVICE=auto on a CPU host),
# fp16 is forced off with a warning — fp16 on CPU is not beneficial and may cause errors.
BGE_FP16=false
# Maximum token length passed to FlagEmbedding's encode() call.
BGE_M3_MAX_LENGTH=8192

# ───── Dynamic batching ─────
# The service uses a micro-batching engine to coalesce concurrent requests into a single model
# call, improving throughput under load. Three tuning knobs control batch formation:
#
# BGE_MAX_BATCH_SIZE  — maximum units per batch (texts for embed/sparse, pairs for rerank).
#                       A single request exceeding this limit is still processed alone.
#                       Range: >= 1. Default 32 is appropriate for most workloads.
BGE_MAX_BATCH_SIZE=32
# BGE_MAX_WAIT_MS     — batch formation window in milliseconds. After the first item arrives,
#                       the worker waits up to this many ms for more items before dispatching.
#                       0 = process immediately (disables wait-based coalescing).
#                       Range: >= 0. Default 10 ms balances latency vs. throughput.
BGE_MAX_WAIT_MS=10
# BGE_MAX_QUEUE_SIZE  — per-op bounded queue capacity. When full, the service responds HTTP 503
#                       with Retry-After: 1 instead of queuing indefinitely (back-pressure).
#                       Range: >= 1. Raise on high-traffic servers.
BGE_MAX_QUEUE_SIZE=256
#
# Tip: set BGE_MAX_BATCH_SIZE=1 + BGE_MAX_WAIT_MS=0 to disable batching completely (useful for
# debugging or very low-load environments where per-request latency matters more than throughput).

# ───── Torch thread budget ─────
# Number of intra-op threads torch may use per inference call (torch.set_num_threads).
# 0 = auto: derived at startup as ceil(cpu_count / 1) since the batching engine serialises
# model calls via a shared asyncio.Lock (concurrency = 1 on the model at all times).
# Set to a positive integer to override — useful on machines where os.cpu_count() is wrong
# (e.g. Docker CPU quotas) or when you want fine-grained control over the thread budget.
BGE_TORCH_NUM_THREADS=0

# ───── Request size ceilings (optional — computed defaults shown) ─────
# Max number of items per request (inputs for /embed·/embed_sparse, texts for /rerank).
# Default: 16x BGE_MAX_BATCH_SIZE (16 * 32 = 512). Uncomment to override.
#BGE_MAX_REQUEST_ITEMS=512
# Max characters per individual text (each /embed·/embed_sparse item, each /rerank text/query).
# Default: 8x BGE_M3_MAX_LENGTH (8 * 8192 = 65536). Uncomment to override.
#BGE_MAX_TEXT_CHARS=65536
