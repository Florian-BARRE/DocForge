# ─── BGE model-suite server — environment template ───────────────────────────
# Copy to `services/bge_server/.env`.
# All vars have safe defaults — the service starts without any .env file at all.
# Values here match the production docker compose setup.
#
# ── Build variants (selected at IMAGE BUILD TIME, not via .env) ──────────────
# The Dockerfile ARG TORCH_VARIANT controls which torch wheel is installed:
#   cpu (default, ~2 GB): docker compose build bge_server
#   gpu (~9.5 GB, CUDA 12.4): docker compose build --build-arg TORCH_VARIANT=gpu bge_server
# Set BGE_DEVICE=cuda below when using the gpu image.

# ───── Logging ─────
# Console log level: DEBUG | INFO | WARNING | ERROR
LOGGING_CONSOLE_LEVEL=INFO
# loggerplusplus format class: ShortFormat | DebugFormat
LOGGING_LPP_FORMAT=ShortFormat
# Set to false to disable console output (e.g. redirect to a log aggregator).
LOGGING_ENABLE_CONSOLE=true
# Set to true to enable rotating file logs under /app/bge_server/logs/.
LOGGING_ENABLE_FILE=false
LOGGING_FILE_LEVEL=DEBUG

# ───── BGE model identities ─────
# HuggingFace model ID for the dense + sparse embedding model (BGEM3FlagModel).
BGE_M3_MODEL=BAAI/bge-m3
# HuggingFace model ID for the cross-encoder reranker (FlagReranker).
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ───── BGE device policy ─────
# Controls which compute device the models are loaded on.
#   auto  -> prefer GPU (CUDA) if available, fall back to CPU silently (default, safe everywhere).
#   cuda  -> require GPU; fails loud at startup if no CUDA device is found (no silent fallback).
#   cpu   -> always use CPU regardless of GPU availability.
# GPU reservation in docker compose: see the commented `reservations:` block under bge_server deploy.
BGE_DEVICE=auto

# ───── BGE runtime knobs ─────
# Request fp16 precision. GATED: only applied when BGE_DEVICE resolves to "cuda".
# If BGE_FP16=true but the resolved device is "cpu" (e.g. BGE_DEVICE=auto on a CPU host),
# fp16 is forced off with a warning — fp16 on CPU is not beneficial and may cause errors.
BGE_FP16=false
# Maximum token length passed to FlagEmbedding's encode() call.
BGE_M3_MAX_LENGTH=8192
