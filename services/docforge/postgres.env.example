# ─── PostgreSQL 16 — bootstrap template ────────────────────────────────
# Copy to `services/docforge/postgres.env`. Consumed by the official postgres
# image on first start (creates the DB + user). POSTGRES_PASSWORD MUST match the password
# app+worker connect with — that is the POSTGRES_DSN compose/base.yml injects (its
# ${POSTGRES_DSN:-...docforge:docforge...} local-dev fallback, OR a POSTGRES_DSN you set in the
# project-root .env, which overrides it). The shipped default below is `docforge`, matching that
# fallback so a fresh clone boots without an auth error.
#
#   ⚠️  For ANY deployment beyond local dev: change this to a strong password AND set a matching
#       POSTGRES_DSN in the project-root .env (see .env.example). Keep the two in sync.
POSTGRES_USER=docforge
POSTGRES_PASSWORD=docforge
POSTGRES_DB=docforge
