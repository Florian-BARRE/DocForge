# ─── DocForge backend + worker — environment template ──────────────────────────
# Copy to `services/docforge/.env` and adjust. Values below are working LOCAL-DEV
# defaults (internal docker network: hostnames = compose service names).
#
#   ⚠️  CHANGE every password/secret/token before any deployment beyond local dev.
#
# Variables not listed here fall back to the defaults in
# common/base_config/runtime/base_config.py (shared) + app/config + worker/config.

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat

# ───── FastAPI ─────
FASTAPI_APP_NAME=DocForge
FASTAPI_DEBUG_MODE=true
# CORS — Vite dev server (host:10023) + API (host:10020).
CORS_ALLOWED_ORIGINS=http://localhost:10023,http://localhost:5173,http://localhost:10020
APP_VERSION=0.1.0

# ───── PostgreSQL (service: postgres) — keep in sync with services/postgres/.env ─────
POSTGRES_USER=docforge
POSTGRES_PASSWORD=change_me            # ⚠️ dev only — use a strong secret elsewhere
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docforge

# ───── SeaweedFS S3 (service: seaweedfs, S3 port 8333) ─────
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=change_me_access
S3_SECRET_KEY=change_me_secret         # ⚠️ dev only
S3_BUCKET=docforge-objects
S3_REGION=us-east-1
# Browser-facing S3 base for presigned URLs (rewritten from the internal endpoint so
# the host can resolve them outside the docker network).
S3_PUBLIC_URL=http://localhost:10021

# ───── Gotenberg (service: gotenberg) ─────
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_S=120

# ───── Pipeline providers ─────
# GPU flags below are a DEPLOYMENT decision for the local providers (set to true only on the
# GPU worker image via docker-compose.gpu.yml). They are NOT per-collection pipeline knobs.
PARSER_DEFAULT_BACKEND=docling
DOCLING_USE_GPU=false
PADDLE_USE_GPU=false
VIT_USE_GPU=false

# ───── Redis (arq queue, service: redis) ─────
REDIS_URL=redis://redis:6379

# ───── Workers & observability ─────
WORKER_MAX_JOBS=10
WORKER_ALLOW_ABORT=true
OBS_HEARTBEAT_INTERVAL_S=5
OBS_HEARTBEAT_TTL_S=15
OBS_METRICS_ENABLED=true
SSE_KEEPALIVE_SECONDS=15
SSE_CLIENT_QUEUE_MAXSIZE=100

# ───── Resource admission / back-pressure ─────
ADMISSION_ENABLED=true
ADMISSION_MAX_QUEUE_DEPTH=0            # 0 = unlimited
ADMISSION_MAX_IN_FLIGHT_GLOBAL=0      # 0 = unlimited

# ───── S5b metagen — LLM-generated chunk/document metadata ─────
METAGEN_ENABLED=false                 # off by default; empty pipeline.metagen is also a no-op
METAGEN_MAX_BUDGET_USD=0.0            # 0.0 = unlimited (provider URL+secret are per-collection in DB)

# ───── Authentication / authorization (web-only) ─────
# Kill-switch: false = no auth, every route runs as a synthetic root (rétro-compat / open dev).
# Set to true to require credentials (root API key | JWT | DB API key).
AUTH_ENABLED=false
# Break-glass root account — bootstrapped at startup. CHANGE both before any real deployment.
AUTH_ROOT_USERNAME=root
AUTH_ROOT_PASSWORD=change_me_root_password      # ⚠️ hashed at boot; never stored in plaintext
AUTH_ROOT_API_KEY=change_me_root_api_key        # ⚠️ static break-glass Bearer key (constant-time compared)
# JWT minting — signing secret for login tokens + their lifetime (minutes; 720 = 12 h).
AUTH_JWT_SECRET=change_me_jwt_secret             # ⚠️ use a long random secret
AUTH_JWT_TTL_MINUTES=720

# ───── Qdrant (service: qdrant, REST port 6333) ─────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false

# ───── ML providers (embed / rerank / OCR / VLM / LLM) — NOT configured here ─────
# Provider URLs, API keys and models live PER-COLLECTION (in the DB, via each collection's
# pipeline config), never in env. The local bge model host (compose service `bge_server`) is the
# default embed/rerank target through the provider's structural default — nothing to set here.
# To use a cloud provider (OpenAI/Mistral/Cohere/…), put its base_url + key in the collection.
