# ─── DocForge — app + worker environment template ───────────────────────
# Copy to `services/docforge/.env` and adjust. Values below are working
# LOCAL-DEV defaults: the four infra endpoints point at localhost:<host-port> so the
# app/worker can run straight from `uv run` on the host. When the containerised stack
# runs (`--profile full`), docker-compose.yml OVERRIDES POSTGRES_DSN / REDIS_URL /
# QDRANT_URL / S3_ENDPOINT_URL with in-network hostnames — leave those as localhost here.
#
#   ⚠️  CHANGE every password/secret before any deployment beyond local dev.
#
# ML providers (embed / rerank / OCR / VLM / LLM) are NOT configured here: their base_url,
# API key and model live PER-COLLECTION in the DB (each collection's pipeline config), never
# in env. To use OpenAI/Mistral/Cohere/a local host, set it on the collection.

# ───── Image tag (COMPOSE INTERPOLATION — drives image selection only) ─────
# docker-compose.yml pulls ghcr.io/florian-barre/docforge-<svc>:${DOCFORGE_TAG:-latest}.
# NOTE: compose reads ${DOCFORGE_TAG} from the SHELL env or a project-root `.env`, NOT from
# this per-service env_file. Defaults to `latest`; export it or add it to a root `.env` to pin.
# The worker ALSO reads DOCFORGE_TAG (if injected into its env) to stamp exported-bundle provenance,
# falling back to "unknown" when unset — optional and unrelated to image selection.
# DOCFORGE_TAG=latest

# ───── FastAPI ─────
FASTAPI_APP_NAME=DocForge
# App version surfaced in OpenAPI/docs. Leave UNSET to inherit the deployment's DOCFORGE_TAG (the
# pinned image tag), so the API advertises the version it ships; falls back to "unknown" locally.
# Set it here only to pin a version independent of the image tag.
# FASTAPI_APP_VERSION=
# Dev opts in explicitly. MUST be false in prod — true leaks full tracebacks to API clients.
FASTAPI_DEBUG_MODE=false
# CORS — Vite dev server (host:10046) + API (host:10040).
FASTAPI_CORS_ALLOWED_ORIGINS=http://localhost:10046,http://localhost:10040

# ───── Authentication (API-key bearer, keys-only) ─────
# OFF by default: local dev and the units suite run with no credentials. Set AUTH_ENABLED=true and
# a strong AUTH_ROOT_TOKEN to gate every /api/v1/* route (scalar docs + /openapi.json stay public).
# The root token is provisioned idempotently at startup as the root user's full-access API key.
AUTH_ENABLED=false
AUTH_ROOT_TOKEN=df_dev_root_token_change_me
# Seconds an authenticated request may skip the DB key-lookup (in-process cache). A revoked key keeps
# working for at most this long per process; 0 disables the cache (every request reads Postgres).
AUTH_KEY_CACHE_TTL_SECONDS=10.0

# ───── Logging (all 5 required) ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_FILE_LEVEL=DEBUG
LOGGING_ENABLE_CONSOLE=true
LOGGING_ENABLE_FILE=false
LOGGING_LPP_FORMAT=ShortFormat

# ───── Redis — arq queue (service: docforge_redis, host port 10042) ─────
REDIS_URL=redis://localhost:10042/0

# ───── PostgreSQL — source of truth (service: docforge_postgres, host port 10041) ─────
# Full SQLAlchemy async DSN for HOST-SIDE tooling (uv-run dev, alembic, psql over the published
# 10041 port). Credentials MUST match services/docforge/postgres.env's POSTGRES_PASSWORD. The shipped
# default is `docforge` so a fresh clone works out of the box; change both together for a deployment.
POSTGRES_DSN=postgresql+asyncpg://docforge:docforge@localhost:10041/docforge
# Async connection pool per PROCESS (the app, and EACH worker replica). pool_size + max_overflow is
# the hard per-engine ceiling; the whole deployment (app + worker×N via `--scale`) must sum under
# Postgres max_connections (compose sets 50). Defaults 5+10 = 15/process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Recycle a pooled connection older than this (seconds) so an idle-timeout never hands back a dead socket.
DB_POOL_RECYCLE_SECONDS=1800

# ───── Qdrant — vector store (service: docforge_qdrant, host port 10043) ─────
QDRANT_URL=http://localhost:10043
# QDRANT_API_KEY=                       # optional — unset for the local unauthenticated Qdrant
# Per-request Qdrant timeout (seconds). The client's 5s default is too low for heavy wait=true
# upserts; 60s covers a heavy batch. Read by both app and worker.
QDRANT_TIMEOUT_SECONDS=60

# ───── SeaweedFS S3 — blob store (service: docforge_seaweedfs, host port 10044) ─────
# SeaweedFS enforces an IDENTITY (services/docforge/s3_config.json, mounted read-only into the
# container) — it is NOT anonymous. These two values MUST match that file's
# identities[0].credentials[0].accessKey / secretKey exactly, or every S3 call gets a 403.
S3_ENDPOINT_URL=http://localhost:10044
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
S3_BUCKET=docforge-objects
S3_REGION=us-east-1

# ───── Collection export/import (portable .dcexport bundles) ─────
# S3 key prefix an UPLOADED import bundle is staged under before the worker consumes it (kept
# distinct from the worker's EXPORT_BUNDLE_PREFIX so produced exports and staged imports never
# collide). Staged objects are named by a fresh UUID; a GC sweep of this prefix reclaims bundles
# whose import never completed. Read by the app (POST /api/v1/collections/import).
IMPORT_STAGING_PREFIX=collection-imports
# Hard ceiling on an uploaded import bundle (bytes). The spool aborts with a 413 past this and stages
# nothing — without it a single upload could exhaust the object store's disk. Default 5 GiB.
IMPORT_MAX_BUNDLE_BYTES=5368709120
# Worker-side export knobs. EXPORT_BUNDLE_PREFIX = S3 key prefix a produced .dcexport lands under;
# EXPORT_COMPRESSION = "zstd" (default) or "none"; EXPORT_TTL_SECONDS = how long a bundle stays
# downloadable before a GC sweep may reclaim it (default 604800 = 7 days).
EXPORT_BUNDLE_PREFIX=collection-exports
EXPORT_COMPRESSION=zstd
EXPORT_TTL_SECONDS=604800
# Reclaim expired export bundles (the S3 object AND its tracking row) on a worker cron — without it
# the download route refuses an expired bundle but the bytes + row leak forever. ON by default; the
# cadence is how often the sweep runs (minutes). Disable to skip the sweep (cron not registered).
WORKER_TRANSFER_GC_ENABLED=true
WORKER_TRANSFER_GC_INTERVAL_MINUTES=15
# Staleness horizon (seconds) for the stuck-TRANSFER reaper: a collection_transfer row RUNNING this
# long past its last write is marked FAILED — recovering a row a worker hard-kill/arq-timeout left
# RUNNING forever. MUST exceed arq's job_timeout ceiling (WORKER_JOB_TIMEOUT_MAX_SECONDS + GRACE) so a
# legitimately long transfer is never falsely reaped (validated at startup). Gated by WORKER_REAP_ENABLED.
WORKER_TRANSFER_REAP_STALE_SECONDS=10800

# ───── Audit trail (app writes rows; worker prunes them) ─────
# Record one append-only audit_log row per mutating /api/v1 request (POST/PUT/PATCH/DELETE). ON
# out-of-box; the write is fail-safe (a DB error is logged + swallowed, never surfaced to the user).
AUDIT_ENABLED=true
# Hard ceiling for one GET /audit page (keyset-paginated); the server clamps a larger requested limit.
AUDIT_MAX_PAGE_SIZE=200
# Audit retention (DAYS). 0 = KEEP FOREVER (default) — with 0 the prune cron is not even registered.
AUDIT_RETENTION_DAYS=0
# Master switch for the audit retention sweep (worker cron); a no-op unless AUDIT_RETENTION_DAYS > 0.
WORKER_AUDIT_GC_ENABLED=true
# Audit-GC cron cadence (minutes): 60 → hourly. Also runs once at startup.
WORKER_AUDIT_GC_INTERVAL_MINUTES=60

# ───── Job-history retention (worker cron; prunes terminal job + job_stage_event rows) ─────
# Retention (DAYS) for TERMINAL jobs + their stage-events. 0 = KEEP FOREVER (default) — with 0 the
# prune cron is not even registered. A job still holding an un-GC'd full-trace payload is skipped
# (the trace GC reclaims those first), so keep this >= WORKER_TRACE_RETENTION_DAYS when set.
JOB_HISTORY_RETENTION_DAYS=0
# Master switch for the job-history retention sweep (worker cron); a no-op unless JOB_HISTORY_RETENTION_DAYS > 0.
WORKER_JOB_HISTORY_GC_ENABLED=true
# Job-history-GC cron cadence (minutes): 60 → hourly. Does NOT run at startup.
WORKER_JOB_HISTORY_GC_INTERVAL_MINUTES=60

# ───── Idempotency (Idempotency-Key middleware; app dedups, worker prunes) ─────
# ON out-of-box but SAFE: only engages when a mutating request to an ELIGIBLE small-JSON endpoint
# (create/update collection, reingest, export, create/rotate key) carries an `Idempotency-Key` header.
# First request runs once + the response is cached; a retry with the same key+body replays it (adds an
# `Idempotency-Replayed: true` header), a different body → 422, an in-flight duplicate → 409. The large
# multipart uploads (document ingest + import bundle) are excluded. Set false for a full passthrough.
IDEMPOTENCY_ENABLED=true
# How long a cached record is honoured before the worker GC prunes it (HOURS). 24 = the Stripe default.
IDEMPOTENCY_TTL_HOURS=24
# Hard cap (BYTES) on a request/response body the middleware buffers to fingerprint + cache. Eligible
# bodies are small JSON, so 262144 (256 KiB) is ample; a rare eligible body over this SKIPS idempotency
# (logged) and streams through rather than risk an out-of-memory buffer.
IDEMPOTENCY_MAX_BODY_BYTES=262144
# Prune expired idempotency records on a worker cron (without it the store grows unbounded). ON by
# default; the cadence is how often the sweep runs (minutes). Disable to skip it (cron not registered).
WORKER_IDEMPOTENCY_GC_ENABLED=true
WORKER_IDEMPOTENCY_GC_INTERVAL_MINUTES=60

# ───── Search & live streams (app-only) ─────
# Wall-clock cap for one inline search run (seconds). Guards a stuck/cold provider — a cold CPU
# embedder's first encode can breach a tight cap and 422. Raise on a slow/contended deployment.
SEARCH_RUN_TIMEOUT_SECONDS=30
# Poll cadence (seconds) for the live job SSE stream (poll-backed, no message bus).
SSE_POLL_INTERVAL_SECONDS=0.75
# Inline pipeline dry-run preview (POST /collections/{id}/pipeline/preview) — synchronous, so bounded:
# a wall-clock run cap, a body-size cap, a chunk-count ceiling and a per-chunk text clip.
PREVIEW_RUN_TIMEOUT_SECONDS=120
PREVIEW_MAX_BYTES=10485760
PREVIEW_MAX_CHUNKS=20
PREVIEW_CHUNK_TEXT_MAX_CHARS=2000

# ───── Rate limiting (in-app, OFF by default) ─────
# OFF out-of-box so no deployment breaks; enable per the prod runbook. Each caller may issue at most
# RATE_LIMIT_PER_MINUTE requests per rolling minute to /api/v1/* — keyed by API key when auth is on,
# else by client IP. The job monitoring subtree (/api/v1/jobs — SSE + polls) is EXEMPT. 429 + Retry-After.
RATE_LIMIT_ENABLED=false
# Per-caller budget (requests per rolling minute). Generous so a normal UI session never trips it.
RATE_LIMIT_PER_MINUTE=600
# Trust the leftmost X-Forwarded-For hop for IP keying (auth-off mode). The reverse proxy MUST
# overwrite (not append) XFF with the real client for this to be spoof-safe; set false on direct exposure.
RATE_LIMIT_TRUST_FORWARDED_FOR=true

# ───── Metrics (Prometheus /metrics, ON by default) ─────
# ON out-of-box — no PII, only ops counters/gauges. Lives outside /api/v1 → auth- AND rate-limit-exempt;
# operators MUST network-restrict it at the proxy/firewall. Set false to hide it (endpoint then 404s).
METRICS_ENABLED=true
# Wall-clock cap (seconds) for one scrape's infra-gauge refresh (queue depth + job/worker counts); a
# degraded store never wedges a scrape — HTTP series + gauge definitions still render.
METRICS_SCRAPE_TIMEOUT_SECONDS=5

# ───── Capabilities discovery (public GET /capabilities) ─────
# Base URLs the discovery endpoint probes (/health, short timeout, short TTL cache) to report which
# OPTIONAL sidecars are reachable — a sidecar whose compose profile is off simply reads unreachable
# and its kinds drop out of the capability matrix. Defaults are the in-stack compose aliases; override
# only if a sidecar lives elsewhere.
CAPABILITIES_BGE_SERVER_URL=http://bge_server:80
CAPABILITIES_PADDLE_SERVER_URL=http://paddle_server:80
CAPABILITIES_MINERU_SERVER_URL=http://mineru_server:80
CAPABILITIES_DOTS_OCR_SERVER_URL=http://dots_ocr_server:80
CAPABILITIES_GOTENBERG_URL=http://gotenberg:3000
# Per-probe HTTP timeout (seconds) — short so an undeployed sidecar fails fast.
CAPABILITIES_PROBE_TIMEOUT_SECONDS=2.0
# How long a probe-result map is reused before the next refresh (seconds) — a burst of discovery
# calls costs at most one probe round per window.
CAPABILITIES_CACHE_TTL_SECONDS=10.0

# ───── Worker run limits ─────
# Friendly display name for this worker in the fleet view (GET /jobs/workers/live). Optional —
# defaults to the container hostname. Set a readable name per worker if you run several.
WORKER_NAME=
WORKER_CONCURRENCY=2
# Global default per-run engine job timeout (seconds). Must be <= WORKER_JOB_TIMEOUT_MAX_SECONDS.
WORKER_JOB_TIMEOUT_SECONDS=1800
# Hard ceiling any single run may request: a per-collection job_timeout_seconds is honoured up to
# this and rejected (fail-fast) above it. arq's outer per-job cap is derived from this value.
WORKER_JOB_TIMEOUT_MAX_SECONDS=7200
# Grace added on top of the MAX job timeout to derive arq's outer cap, so the engine job timeout fires first.
WORKER_JOB_TIMEOUT_GRACE_SECONDS=60
# Bounded thread pool for the heavy CPU stages (docling/ocr/render/chunk).
WORKER_HEAVY_THREADS=4
# Provider reachability preflight (fail-fast before spend). ON by default: the stock pipeline ships
# its provider-hosted stages (enrich VLM, metagen LLM) OFF, so only real in-stack nodes are probed;
# a stage you opt in is preflighted before its first spend. Set false to skip reachability checks
# entirely (see docs/PROD-HARDENING.md).
WORKER_PREFLIGHT_ENABLED=true
WORKER_PREFLIGHT_CACHE_TTL_SECONDS=300
# Operator ceiling on execution-trace capture: a per-collection trace_verbosity is clamped to
# min(collection, ceiling). Default "full" is PERMISSIVE: the per-collection trace_verbosity is
# authoritative (it defaults to "shape", so a collection still captures only cheap summaries until it
# opts into "full" — nothing raw at rest without that opt-in). Set this to "shape" to FORBID full
# capture fleet-wide regardless of a collection's setting; a "shape" ceiling no-ops every "full" opt-in.
WORKER_TRACE_MAX_VERBOSITY=full
# Per-payload byte cap for the FULL trace tier: a node input/output whose serialised payload exceeds
# this is stored truncated behind a marker (its shape summary is unaffected). Only used at "full".
WORKER_TRACE_PAYLOAD_MAX_BYTES=1048576
# Retention (days) for stored full-trace payloads — consumed by the gc_trace_payloads cron to
# prefix-delete a job's trace/{job_id}/ object-store space once its jobs age past this. 0 = keep-forever
# (the cron is then not registered), so an out-of-box deployment never deletes trace payloads.
WORKER_TRACE_RETENTION_DAYS=14
# How often the trace-retention GC runs (minutes), plus once at startup. Only used when retention > 0.
WORKER_TRACE_GC_INTERVAL_MINUTES=60
# Max jobs whose payloads one GC pass reclaims — bounds a single sweep so a big backlog drains across runs.
WORKER_TRACE_GC_BATCH_SIZE=500

# ───── Worker liveness (monitoring / fleet view) ─────
# Worker heartbeat tick interval (seconds). Kept well below WORKER_ALIVE_THRESHOLD_SECONDS.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# A worker heartbeat fresher than this reads as "alive" in GET /jobs/workers/live (app-side).
WORKER_ALIVE_THRESHOLD_SECONDS=30
# A worker heartbeat frozen past this is pruned (deleted + dropped from the fleet view), so a
# crashed worker vanishes instead of lingering as a permanent "off" card. Keep it well above the
# alive threshold so a live worker that missed a few beats is never deleted. Read by app AND worker.
WORKER_PRUNE_STALE_SECONDS=180
# arq writes a health record to Redis every N seconds; `arq ... --check` reads it for the healthcheck.
WORKER_HEALTH_CHECK_INTERVAL_SECONDS=30

# ───── Stuck-job reaper (worker cron) ─────
# Fails RUNNING jobs idle past the stale cutoff and releases their document to FAILED. A dev
# hot-reload or crash drops the in-flight arq task while the DB row stays RUNNING forever without it.
# Set false to skip the reaper entirely (the cron is then not even registered).
WORKER_REAP_ENABLED=true
# A RUNNING job idle longer than this (seconds) is reaped. Must be >= 60 (the worker refuses to boot
# below that); 1200s (20m) sits above the slowest observed single-doc run so a slow-but-alive job survives.
WORKER_REAP_STALE_SECONDS=1200
# Job-level watchdog grace (seconds). The reaper's SECOND, heartbeat-independent condition fails a
# RUNNING job on a LIVE worker whose age exceeds its effective job timeout (per-collection
# job_timeout_seconds, else WORKER_JOB_TIMEOUT_SECONDS) PLUS this grace — the backstop for a wedged
# native stage arq's async cancel cannot kill (attributed job_timeout_exceeded). Generous so a job the
# engine is about to cancel cleanly at its job timeout is never falsely reaped.
WORKER_OVER_JOB_TIMEOUT_GRACE_SECONDS=300
# Reaper cron cadence (minutes): runs on every Nth minute of the hour, plus once at startup.
WORKER_REAP_INTERVAL_MINUTES=5

# ───── Document grid (corpus view) ─────
# Hard ceiling for one grid query page; the server clamps a larger requested limit down to this.
CORPUS_MAX_PAGE_SIZE=500
# Per-call cap on a bulk re-ingest fan-out (a filter matching more enqueues the first N, reports capped).
CORPUS_MAX_REINGEST_FANOUT=1000
# Per-call cap on a bulk DELETE selection (a filter matching more deletes the first N, reports capped; re-run for the rest).
CORPUS_MAX_DELETE_SELECTION=10000

# ───── Cost estimate ─────
# A subset estimate (ids/filter) matching more than this measures the first N rows and scales linearly.
ESTIMATE_MAX_SAMPLE_DOCUMENTS=2000

# ───── Jobs list (monitoring view) ─────
# Hard ceiling for one GET /jobs page; the server clamps a larger requested limit down to this and
# defaults to it, so a heavily re-ingested collection's thousands of job rows never dump unbounded.
JOBS_MAX_PAGE_SIZE=500
# Read cap (bytes) for the full execution-trace payload fetch route: a stored payload larger than this
# is reported truncated (size only, no body). Above the worker capture cap (WORKER_TRACE_PAYLOAD_MAX_BYTES).
TRACE_PAYLOAD_READ_MAX_BYTES=4194304
