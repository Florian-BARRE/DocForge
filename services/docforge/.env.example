# ─── DocForge backend + worker — environment template ──────────────────────────
# Copy to `services/docforge/.env` and adjust. Values below are working LOCAL-DEV
# defaults (internal docker network: hostnames = compose service names).
#
#   ⚠️  CHANGE every password/secret/token before any deployment beyond local dev.
#
# Variables not listed here fall back to the defaults in
# common/base_config/runtime/base_config.py (shared) + app/config + worker/config.

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat

# ───── FastAPI ─────
FASTAPI_APP_NAME=DocForge
FASTAPI_DEBUG_MODE=true
# CORS — Vite dev server (host:10023) + API (host:10020).
CORS_ALLOWED_ORIGINS=http://localhost:10023,http://localhost:5173,http://localhost:10020
APP_VERSION=0.1.0

# ───── PostgreSQL (service: postgres) — keep in sync with services/postgres/.env ─────
POSTGRES_USER=docforge
POSTGRES_PASSWORD=change_me            # ⚠️ dev only — use a strong secret elsewhere
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docforge

# ───── SeaweedFS S3 (service: seaweedfs, S3 port 8333) ─────
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=change_me_access
S3_SECRET_KEY=change_me_secret         # ⚠️ dev only
S3_BUCKET=docforge-objects
S3_REGION=us-east-1
# Browser-facing S3 base for presigned URLs (rewritten from the internal endpoint so
# the host can resolve them outside the docker network).
S3_PUBLIC_URL=http://localhost:10021

# ───── Gotenberg (service: gotenberg) ─────
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_S=120

# ───── Pipeline providers ─────
PARSER_DEFAULT_BACKEND=docling
DOCLING_USE_GPU=false

# ───── Redis (arq queue, service: redis) ─────
REDIS_URL=redis://redis:6379

# ───── Workers & observability ─────
WORKER_MAX_JOBS=10
WORKER_ALLOW_ABORT=true
OBS_HEARTBEAT_INTERVAL_S=5
OBS_HEARTBEAT_TTL_S=15
OBS_METRICS_ENABLED=true
SSE_KEEPALIVE_SECONDS=15
SSE_CLIENT_QUEUE_MAXSIZE=100

# ───── Resource admission / back-pressure ─────
ADMISSION_ENABLED=true
ADMISSION_MAX_QUEUE_DEPTH=0            # 0 = unlimited
ADMISSION_MAX_IN_FLIGHT_GLOBAL=0      # 0 = unlimited

# ───── Qdrant (service: qdrant, REST port 6333) ─────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false

# ───── Embedding / rerank (service: bge — local BGE model host, src/bge_server) ─────
# NOTE: provider URLs are migrating to PER-COLLECTION config (stored in the DB); these
# env vars are a transition-period default for the shared query-time provider.
TEI_BASE_URL=http://bge:80
TEI_EMBED_SPARSE=false                 # shared query provider stays dense; per-collection sparse in pipeline
BGE_RERANKER_URL=http://bge:80
BGE_RERANKER_BATCH_SIZE=32

# ───── Optional cloud providers (leave empty/commented if unused) ─────
#OPENAI_API_KEY=
#EMBED_API_KEY=
#COHERE_API_KEY=
#LLM_API_BASE_URL=http://localhost:8080/v1
#LLM_API_KEY=
#LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
