# ─── DocForge MCP server — environment template ────────────────────────────────
# Copy to `services/mcp/.env`. This service is a pure HTTP client of the
# DocForge API — it needs NO database/S3 secrets. Defaults live in src/mcp/config_loader.py.

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat

# ───── DocForge API target (service name on docforge_net) ─────
DOCFORGE_API_URL=http://docforge:8000
MCP_API_TIMEOUT_S=60

# ───── MCP transport ─────
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_HTTP_PATH=/mcp

# ───── Auth (REQUIRED in HTTP mode) ─────
# The server refuses to start in HTTP mode while this is empty/default.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change-me-generate-a-strong-token

# ───── DocForge API auth (outbound — MCP -> DocForge) ─────
# Set when the DocForge API has AUTH_ENABLED=true. Must match the DocForge AUTH_ROOT_API_KEY
# or any per-user API key registered in the DB. Leave empty (or omit) only when auth is disabled.
# Auto-masked in logs because the name contains TOKEN.
#DOCFORGE_API_TOKEN=
