# ─── DocForge MCP server — environment template ────────────────────────────────
# Copy to `services/mcp/.env`. This service is a pure HTTP client of the
# DocForge API — it needs NO database/S3 secrets. Defaults live in src/mcp/config_loader.py.

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat

# ───── DocForge API target (service name on docforge_net) ─────
DOCFORGE_API_URL=http://docforge_app:8000
MCP_API_TIMEOUT_S=60

# ───── MCP transport ─────
# Auth is delegated to DocForge — there is no separate MCP-level gate. Each HTTP request must
# carry "Authorization: Bearer <docforge-api-key>"; it is forwarded upstream as-is, so a caller
# gets exactly the rights that key has on the DocForge REST API. TLS MUST front this port in
# production (a reverse proxy terminating HTTPS) since the key travels in the Authorization header.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_HTTP_PATH=/mcp

# ───── DocForge API fallback token (stdio, or any HTTP request without its own bearer) ─────
# Only used when a request carries no Authorization header of its own (always the case for
# stdio). Set when the DocForge API has AUTH_ENABLED=true. Leave empty (or omit) only when the
# API runs with auth disabled. Auto-masked in logs because the name contains TOKEN.
#DOCFORGE_API_TOKEN=
