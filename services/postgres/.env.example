# ─── PostgreSQL 16 — bootstrap template ─────────────────────────────────────────
# Copy to `services/postgres/.env`. Consumed by the official postgres image on first
# start (creates the DB + user). Must stay in sync with the POSTGRES_* block in
# services/docforge/.env.
#
#   ⚠️  CHANGE POSTGRES_PASSWORD before any deployment beyond local dev.
POSTGRES_USER=docforge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=docforge
