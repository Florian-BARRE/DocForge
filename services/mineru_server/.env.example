# ─── MinerU2.5-Pro VLM layout-parsing sidecar — environment template ─────────────────────────
# Copy to `services/mineru_server/.env`.
# All vars have safe defaults — the service starts without any .env file at all.
#
# GPU-ONLY: MinerU2.5-Pro's VLM backend REQUIRES CUDA (min 8 GB VRAM). This sidecar is opt-in
# (compose profile `mineru`, GPU image) and reports /health UNHEALTHY on a host with no CUDA GPU.
#
# ── Build variants (selected at IMAGE BUILD TIME, not via .env) ──────────────
# The Dockerfile ARG TORCH_VARIANT controls which torch wheel is installed:
#   gpu (CUDA 12.6, for the Tesla V100 sm_70 prod GPU): docker compose build --build-arg TORCH_VARIANT=gpu mineru_server
#   cpu (wiring build-test ONLY — cannot actually parse): docker compose build mineru_server

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat
LOGGING_ENABLE_CONSOLE=true
LOGGING_ENABLE_FILE=false
LOGGING_FILE_LEVEL=DEBUG

# ───── Model cache ─────
# Directory MinerU caches its downloaded VLM weights under. Mounted as a named volume in compose
# so weights persist across container recreations.
MINERU_MODEL_CACHE_HOME=/models
# Model hoster MinerU downloads weights from: huggingface (default) | modelscope.
MINERU_MODEL_SOURCE=huggingface

# ───── MinerU parse ─────
# VLM backend that runs the parse. vlm-transformers (default, dependency-light, needs mineru[core])
# | vlm-vllm-engine | vlm-sglang-engine (faster, need the heavy mineru[vllm]/[sglang] extras added
# at deploy time). GPU-only in every case.
MINERU_BACKEND=vlm-transformers
# OCR/parse language hint forwarded to MinerU (ch auto-handles latin scripts too). The IR language
# is detected downstream by the DocForge docmeta/language node, not here.
MINERU_LANG=ch

# ───── GPU gate ─────
# When true (default), /health reports UNHEALTHY on a host with no visible CUDA GPU so the container
# never advertises a readiness it cannot honor. Set false only for a deliberate CPU wiring smoke-test.
MINERU_REQUIRE_GPU=true

# ───── Request limits ─────
# Hard ceiling (bytes) on a /parse request body the route will buffer (the body IS the PDF).
MINERU_MAX_BODY_BYTES=104857600

# ───── Concurrency ─────
# Max seconds a /parse request waits to acquire the shared predict lock before the router returns
# HTTP 503 (back-pressure — MinerU VLM inference is not concurrency-safe on one GPU).
MINERU_LOCK_WAIT_TIMEOUT_SECONDS=590
