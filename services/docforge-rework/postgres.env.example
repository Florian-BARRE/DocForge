# ─── PostgreSQL 16 (rework) — bootstrap template ────────────────────────────────
# Copy to `services/docforge-rework/postgres.env`. Consumed by the official postgres
# image on first start (creates the DB + user). POSTGRES_PASSWORD MUST match the password
# in the POSTGRES_DSN of services/docforge-rework/.env AND the in-container DSN hardcoded
# in docker-compose.rework.yml (docforge:<password>@rework_postgres) — keep all three in sync.
#
#   ⚠️  CHANGE POSTGRES_PASSWORD before any deployment beyond local dev.
POSTGRES_USER=docforge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=docforge
