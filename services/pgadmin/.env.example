# ─── pgAdmin 4 — web UI bootstrap template ──────────────────────────────────────
# Copy to `services/pgadmin/.env`. Credentials for the pgAdmin web LOGIN itself
# (not the Postgres login — the DocForge server connection is pre-registered).
#
#   ⚠️  CHANGE PGADMIN_DEFAULT_PASSWORD before exposing pgAdmin beyond local dev.
PGADMIN_DEFAULT_EMAIL=admin@docforge.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Disable the extra "master password" prompt (saved server passwords are encrypted
# with the login password above).
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False
