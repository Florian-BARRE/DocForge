# ─── PaddleOCR PP-StructureV3 layout-parsing sidecar — environment template ──────────────────
# Copy to `services/paddle_server/.env`.
# All vars have safe defaults — the service starts without any .env file at all.
#
# ── Build variants (selected at IMAGE BUILD TIME, not via .env) ──────────────
# The Dockerfile ARG TORCH_VARIANT controls which paddlepaddle wheel is installed:
#   cpu (default, ~2.3 GB image): docker compose build paddle_server
#   gpu (~4-5.5 GB, CUDA 12.6): docker compose build --build-arg TORCH_VARIANT=gpu paddle_server

# ───── Logging ─────
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_LPP_FORMAT=ShortFormat
LOGGING_ENABLE_CONSOLE=true
LOGGING_ENABLE_FILE=false
LOGGING_FILE_LEVEL=DEBUG

# ───── Model cache ─────
# Directory PaddleX caches every downloaded inference model under (official_models/ subdir).
# Mounted as a named volume in compose (PADDLE_PDX_CACHE_HOME) so weights persist across
# container recreations.
PADDLE_PDX_CACHE_HOME=/models
# Model hoster: huggingface (default) | bos | aistudio | modelscope.
PADDLE_PDX_MODEL_SOURCE=huggingface

# ───── PP-StructureV3 sub-pipeline toggles (lean default) ─────
# Layout detection + general OCR are always on (no toggle). These four are optional.
PADDLE_USE_TABLE_RECOGNITION=true
PADDLE_USE_FORMULA_RECOGNITION=false
PADDLE_USE_SEAL_RECOGNITION=false
PADDLE_USE_DOC_ORIENTATION_CLASSIFY=false
# Kept false always — see config_loader.py; not meant to be flipped in normal operation.
PADDLE_USE_DOC_UNWARPING=false

# ───── Concurrency ─────
# Max seconds a /layout-parsing request waits to acquire the shared predict lock before the
# router returns HTTP 503 (back-pressure — PaddlePaddle inference is not thread-safe).
PADDLE_LOCK_WAIT_TIMEOUT_SECONDS=290
