# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ───────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv ────────────────────────────────────────────────────
.uv/

# ── Secrets / credentials ─────────────────────────────────
services/**/.env
*.env
!services/**/.env.example
!.env.example

# ── Logs ──────────────────────────────────────────────────
logs/
*.log

# ── Frontend build artifacts ──────────────────────────────
src/docforge/frontend/dist/
src/docforge/frontend/node_modules/
# Stale .js outputs that shadow .tsx/.ts source — Vite resolves them with priority
# and serves an old bundle.  We're TS-only; any .js in src/ is build artefact noise.
src/docforge/frontend/src/**/*.js
src/docforge/frontend/src/**/*.js.map
# Auto-generated OpenAPI types — regenerated via `npm run gen:types`
src/docforge/frontend/src/api/generated.ts

# ── IDE / OS ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Claude Code ───────────────────────────────────────────
.claude/projects/

# ── Alembic / migrations (keep structure, not generated) ──
# src/docforge/migrations/versions/*.py  # comment in to exclude

# ── Test artifacts ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.claude/worktrees/
# Note: the synthetic test corpus under src/docforge/tests/corpus/documents/<ext>/ IS committed
# (deterministic, loaded at test time); it is regenerated via tests/corpus/generation/ when builders change.
